# Normalize line endings in the repo; checkout follows core.autocrlf
* text=auto

# Windows-only scripts need CRLF even on a Linux CI checkout
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell scripts must stay LF
*.sh   text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.woff  binary
*.woff2 binary
*.wav  binary
*.mp3  binary
